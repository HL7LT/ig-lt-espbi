      {
        "id": "Observation",
        "path": "Observation",
        "definition": "Validacijos taisyklė:\r\n- Įvedama \"Arterinis kraujo spaudimas (Kairė, sistolinis)\" reikšmė turi būti didesnė arba lygi \"Arterinis kraujo spaudimas (Kairė, diastolinis)\".\r\n- Įvedama \"Arterinis kraujo spaudimas (Dešinė, sistolinis)\" reikšmė turi būti didesnė arba lygi \"Arterinis kraujo spaudimas (Dešinė, diastolinis)\".",
        "constraint": [
          {
            "key": "obs-13",
            "severity": "error",
            "human": "Left systolic blood pressure must be greater than or equal to diastolic blood pressure.",
            "expression": "(component.where(code.coding.code='8546-4').exists() and component.where(code.coding.code='8514-2').exists()) implies (component.where(code.coding.code='8546-4').valueQuantity.value.first() >= component.where(code.coding.code='8514-2').valueQuantity.value.first())"
          },
          {
            "key": "obs-14",
            "severity": "error",
            "human": "Right systolic blood pressure must be greater than or equal to diastolic blood pressure.",
            "expression": "(component.where(code.coding.code='8547-2').exists() and component.where(code.coding.code='8515-9').exists()) implies (component.where(code.coding.code='8547-2').valueQuantity.value.first() >= component.where(code.coding.code='8515-9').valueQuantity.value.first())"
          }
        ]
      },
