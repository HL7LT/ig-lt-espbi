  "differential": {
    "element": [
      {
        "id": "Observation",
        "path": "Observation",
        "constraint": [
          {
            "key": "obs-11",
            "severity": "error",
            "human": "Systolic blood pressure must be greater than or equal to diastolic blood pressure.",
            "expression": "(component.where(code.coding.code='8480-6').exists() and component.where(code.coding.code='8462-4').exists()) implies (component.where(code.coding.code='8480-6').valueQuantity.value.first() >= component.where(code.coding.code='8462-4').valueQuantity.value.first())"
          },
          {
            "key": "obs-12",
            "severity": "error",
            "human": "Both systolic and diastolic blood pressure values must be provided together.",
            "expression": "component.where(code.coding.code = '8480-6').exists() = component.where(code.coding.code = '8462-4').exists() "
          }
        ]
      },
      {
