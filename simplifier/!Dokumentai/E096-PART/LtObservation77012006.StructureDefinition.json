        "definition": "Validacinė taisyklė:\r\n- Vaisiaus vandenų nutekėjimo arba amniotomijos laikas gali būti aktyvus, kai Vaisiaus vandenys reikšmė: \"Nutekėję\".",
        "constraint": [
          {
            "key": "obs-10",
            "severity": "error",
            "human": "Effective may be present only when the amniotic fluid has code '2' (Nutekėję).",
            "expression": "valueCodeableConcept.coding.where(code='2').exists() implies exists(effective)"
