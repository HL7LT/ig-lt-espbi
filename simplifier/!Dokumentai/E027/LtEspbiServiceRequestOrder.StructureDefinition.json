      {
        "id": "ServiceRequest.performerType",
        "path": "ServiceRequest.performerType",
        "definition": "Specialisto, pas kurį siunčiamas pacientas, prof. kvalifikacija.\r\n\r\nLaukas privalomas, jeigu yra kuriamas siuntimo konsultacijos, tyrimų, gydymo skyrimas.\r\nLaukas negali būti nurodytas kitų tipų skyrimams.\r\nDraudžiama keisti lauko reikšmę  atnaujinant Order resurso duomenis.\r\n\r\nGalimos reikšmės nurodytos klasifikatoriuje qualification-code.",
        "example": [
          {
            "label": "example, when performer is practitioner",
            "valueCodeableConcept": {
              "coding": [
                {
                  "system": "http://esveikata.lt/classifiers/QualificationCode",
                  "code": "221227",
                  "display": "Gydytojas neurologas"
                }
              ]
            }
          },
          {
            "label": "example, when performer is department",
            "valueCodeableConcept": {
              "text": "Skubiosios pagalbos skyrius"
            }
          }
        ]
