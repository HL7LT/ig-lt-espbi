      },
      {
        "id": "Medication.doseForm.text.extension:translation.extension:lang.value[x]",
        "path": "Medication.doseForm.text.extension.extension.value[x]",
        "fixedCode": "en"
      },
      {
        "id": "Medication.doseForm.text.extension:translation.extension:content",
        "path": "Medication.doseForm.text.extension.extension",
        "sliceName": "content",
        "short": "Trumpas pavadinimas anglų kalba / Short name in English"
      },
      {
        "id": "Medication.doseForm.text.extension:translation.extension:content.value[x]",
        "path": "Medication.doseForm.text.extension.extension.value[x]",
        "type": [
          {
            "code": "string"
          }
        ]
      },
      {
        "id": "Medication.ingredient",
