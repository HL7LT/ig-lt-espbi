        "type": [
          {
            "code": "CodeableReference",
            "targetProfile": [
              "http://esveikata.lt/fhir/StructureDefinition/lt-espbi-substance"
            ]
          }
        ]
      },
      {
        "id": "Medication.ingredient.item.reference",
        "path": "Medication.ingredient.item.reference",
        "min": 1
