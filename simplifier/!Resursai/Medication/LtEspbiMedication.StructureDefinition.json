        "path": "Medication.marketingAuthorizationHolder.reference",
        "min": 1
      },
      {
        "id": "Medication.doseForm",
        "path": "Medication.doseForm",
        "short": "Vaistinio preparato forma / Pharmaceutical form ",
        "definition": "Vaisto farmacinės formos pavadinimas lietuvių kalba - pilnas bei trumpas pavadinimai.\r\nGalimos reikšmės nurodytos klasifikatoriuje pharmaceutical-form (http://esveikata.lt/classifiers/PharmaceuticalForm).\r\n\r\nFHIR R5 siūlo naudoti reikšmių sąrašą http://hl7.org/fhir/ValueSet/medication-form-codes, kuriame įtraukti kodai iš http://snomed.info/sct, kur sąvoka yra 736542009 (Farmacinė dozės forma).",
        "mustSupport": true
      },
      {
        "id": "Medication.doseForm.coding",
        "path": "Medication.doseForm.coding",
        "min": 1,
        "max": "1"
      },
      {
        "id": "Medication.doseForm.coding.system",
        "path": "Medication.doseForm.coding.system",
        "min": 1,
        "patternUri": "http://esveikata.lt/classifiers/PharmaceuticalForm"
      },
      {
        "id": "Medication.doseForm.coding.code",
        "path": "Medication.doseForm.coding.code",
        "min": 1
      },
      {
        "id": "Medication.doseForm.coding.display",
