        "id": "Medication.ingredient.item.reference.reference",
        "path": "Medication.ingredient.item.reference.reference",
        "min": 1
      },
      {
        "id": "Medication.ingredient.isActive",
        "path": "Medication.ingredient.isActive",
        "short": "Medžiagos vaidmuo vaisto sudėtyje / Active ingredient indicator",
        "mustSupport": true
      },
      {
        "id": "Medication.ingredient.strength[x]",
        "path": "Medication.ingredient.strength[x]",
        "short": "Medžiagos kiekis vaisto vienete / Quantity of ingredient present",
        "definition": "Ratio - Struktūrizuotas komponento kiekis, kuriame aprašomas medžiagų stiprumas.\r\n\r\nQuantity - Veikliųjų medžiagų stiprumų, atskirtu „/“ simboliu, sąrašas. Jei VP sudaro keli komponentai, tai jų stiprumai atskiriami \"+\" simboliu.",
        "type": [
          {
            "code": "Ratio"
          },
          {
            "code": "Quantity"
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Medication.definition",
        "path": "Medication.definition",
        "short": "Nuoroda į MedicationKnowledge resursą, kuriame išsamiai aprašomas vaistinis preparatas / Knowledge about this medication",
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "http://esveikata.lt/fhir/StructureDefinition/lt-espbi-medication-knowledge"
            ]
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Medication.definition.reference",
        "path": "Medication.definition.reference",
