        "mustSupport": true
      },
      {
        "id": "Medication.doseForm.text.extension:translation",
        "path": "Medication.doseForm.text.extension",
        "sliceName": "translation",
        "short": "Trumpas pavadinimas anglų kalba / Short name in English",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "http://hl7.org/fhir/StructureDefinition/translation"
            ]
          }
        ],
        "isModifier": false
      },
      {
        "id": "Medication.doseForm.text.extension:translation.extension:lang",
