        "short": "Kalbos kodas / Code for Language"
      },
      {
        "id": "Medication.doseForm.coding.display.extension:translation.extension:lang.value[x]",
        "path": "Medication.doseForm.coding.display.extension.extension.value[x]",
        "fixedCode": "en"
