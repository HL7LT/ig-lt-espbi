        "max": "1",
        "example": [
          {
            "label": "example",
            "valueCoding": {
              "system": "http://esveikata.lt/classifiers/immunization-recommendation-status",
              "code": "active",
              "display": "Aktualus"
            }
          }
        ]
      },
