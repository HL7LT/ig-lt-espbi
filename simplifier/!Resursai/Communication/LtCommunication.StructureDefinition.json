{
  "resourceType": "StructureDefinition",
  "url": "http://esveikata.lt/fhir/StructureDefinition/lt-espbi-communication",
  "name": "LtEspbiCommunication",
  "status": "draft",
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
  "type": "Communication",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Communication",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Communication",
        "path": "Communication",
        "constraint": [
          {
            "key": "com-mnd-1",
            "severity": "error",
            "human": "Prohibit alert type mandatory if Alert category is \"1\"",
            "expression": "category.coding.where(system='http://esveikata.lt/classifiers/Alert/Category' and code='1').exists() implies payload.content.ofType(CodeableConcept).coding.where(system='http://esveikata.lt/classifiers/Alert/ProhibitAlertType').exists()"
          },
          {
            "key": "com-mnd-2",
            "severity": "error",
            "human": "Patient or specialist comment alert type mandatory if Alert category is \"4\"",
            "expression": "category.coding.where(system='http://esveikata.lt/classifiers/Alert/Category' and code='4').exists() implies (payload.content.ofType(CodeableConcept).coding.where(system='http://esveikata.lt/classifiers/Alert/CommentAlertType').exists() and payload.content.ofType(CodeableConcept).text.exists())"
          },
          {
            "key": "com-mnd-3",
            "severity": "error",
            "human": "System alert type mandatory if Alert category is \"4\"",
            "expression": "category.coding.where(system='http://esveikata.lt/classifiers/Alert/Category' and code='6').exists() implies payload.content.ofType(CodeableConcept).coding.where(system='http://esveikata.lt/classifiers/Alert/SystemAlertType').exists()"
          }
        ]
      },
      {
        "id": "Communication.id",
        "path": "Communication.id",
        "short": "Resurso identifikatorius / Logical id of the resource",
        "definition": "Resurso unikalus identifikatorius, naudojamas resurso URL adresuose. Kartą priskirta, ši reikšmė niekada nesikeičia.",
        "mustSupport": true
      },
      {
