        ],
        "example": [
          {
            "label": "example-prohibitAlertType",
            "valueCodeableConcept": {
              "coding": [
                {
                  "system": "http://esveikata.lt/classifiers/Alert/ProhibitAlertType",
                  "code": "1",
                  "display": "negali vairuoti"
                }
              ],
              "text": "Informuojame, kad {paciento vardas} {paciento pavardė}, a.k.{paciento asmens kodas}, gyvenantis {paciento deklaruota gyvenamoji vieta}, dėl savo dabartinės sveikatos būsenos negali vairuoti transporto priemonės."
            }
          },
          {
            "label": "example-commentAlertType",
            "valueCodeableConcept": {
              "coding": [
                {
                  "system": "http://esveikata.lt/classifiers/Alert/CommentAlertType",
                  "code": "1",
                  "display": "paciento komentaras"
                }
              ],
              "text": "komentaro tekstas"
            }
          },
          {
            "label": "example-systemAlertType",
            "valueCodeableConcept": {
              "coding": [
                {
                  "system": "http://esveikata.lt/classifiers/Alert/SystemAlertType",
                  "code": "2",
                  "display": "Pranešimas/priminimas apie skiepus siunčiamas suėjus skiepų kalendoriuje numatytai datai."
                }
              ],
              "text": "Informuojame apie artėjantį planuojamą skiepą. Skiepijimo data: 2015-02-16. Užkrečiamos ligos, nuo kurių skiepijama: erkinis encifalitas."
            }
          }
        ]
