          {
            "key": "cov-1",
            "severity": "error",
            "human": "ltExtInsuranceGivenCountry must be present if Coverage.type = '1' (Apdraustas EEE šalyje ar Šveicarijoje).",
            "expression": "(type.coding.code = '1') implies (extension.where(url = 'http://esveikata.lt/Profile/ltnhr-Coverage/insuranceGivenCountry').exists())"
          },
          {
            "key": "cov-2",
            "severity": "error",
            "human": "Coverage.identifier must be present if Coverage.type = '1' (Kita).",
            "expression": "(type.coding.code = '1') implies (identifier.exists())"
          }
        ]
      },
      {
