{
  "resourceType": "StructureDefinition",
  "url": "http://esveikata.lt/fhir/StructureDefinition/lt-espbi-composition-diagnostics",
  "name": "LtEspbiCompositionDiagnostics",
  "status": "draft",
  "description": "Duomenų kompozicijos specializuotas profilis, skirtas patologijos ir kitų diagnostinių tyrimų bei kitiems dokumentams / Composition profile for pathology and other diagnostic study, and other documents.\n \nProfilis sukurtas pagal LtEspbiComposition profilį. Šis profilis paveldi LtEspbiComposition resurso profilio struktūrą, tačiau jame yra pašalinti (nustatytas kardinalumas 0..0) tie duomenų elementai ir vidiniai elementai, kurie diagnostinių tyrimų dokumentuose nenaudojami.",
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
  "type": "Composition",
  "baseDefinition": "http://esveikata.lt/fhir/StructureDefinition/lt-espbi-composition",
  "derivation": "constraint",
