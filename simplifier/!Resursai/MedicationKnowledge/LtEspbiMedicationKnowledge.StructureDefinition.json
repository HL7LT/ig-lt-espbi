        "path": "MedicationKnowledge.monograph.source.reference",
        "min": 1
      },
      {
        "id": "MedicationKnowledge.cost",
        "path": "MedicationKnowledge.cost",
        "short": "Vaistinio preparato kaina / The pricing of the medication",
        "definition": "Nurodoma:\r\n\r\n- Vaistinio preparato ar MPP kompensuojama suma su PVM (suma, valiuta, matavimo vienetų sutrumpinimų klasifikatorius).\r\n\r\n- Vaistinio preparato ar MPP mažmeninė kaina su PVM (suma, valiuta, matavimo vienetų sutrumpinimų klasifikatorius).",
        "mustSupport": true
      },
      {
        "id": "MedicationKnowledge.cost.type",
        "path": "MedicationKnowledge.cost.type",
        "short": "Kainos tipas / The category of the cost information",
        "definition": "Rekomenduojama sukurti klasifikatorių, kuriame būtų pateiktos kainos tipo reikšmės, pvz., kompensuojama, mažmeninė ir t. t."
      },
