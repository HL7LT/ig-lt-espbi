      {
        "id": "MedicationKnowledge.medicineClassification",
        "path": "MedicationKnowledge.medicineClassification",
        "short": "Vaistinio preparato klasifikavimas / Categorization of the medication within a formulary or classification system",
        "mustSupport": true
      },
      {
        "id": "MedicationKnowledge.medicineClassification.type",
        "path": "MedicationKnowledge.medicineClassification.type",
        "short": "Vaistinio preparato klasifikavimo tipas / The type of category for the medication (for example, therapeutic classification, therapeutic sub-classification)",
        "definition": "Rekomenduojama sukurti klasifikatorių, kuriame būtų aprašytos galimos vaistinio preparato klasifikavimo tipo, t. y. pagal kokią sistemą ar aspektą klasifikuojamas vaistinis preparatas, reikšmės, pvz.: vaistinio preparato grupė, vaistinio preparato pogrupis, vasitinio preparato kontroliuojamos medžiagos tipas ir pnš."
      },
      {
        "id": "MedicationKnowledge.medicineClassification.classification",
        "path": "MedicationKnowledge.medicineClassification.classification",
        "short": "Vaistiniam preparatui priskirta klasifikacijos kategorija / Specific category assigned to the medication",
        "definition": "Pateikiami duomenys:\r\n\r\nKontroliuojamos medžiagos tipas / Controlled medication type. Galimos reikšmės nurodytos klasifikatoriuje controlled-type (http://esveikata.lt/classifiers/ControlledType).\r\n\r\nGrupė, kuriai priklauso vaistinis preparatas arba MPP. Galimos reikšmės nurodytos klasifikatoriuje medication-group (http://esveikata.lt/classifiers/Medication/MedicationGroup).\r\n\r\nPogrupis. Galimos reikšmės nurodytos klasifikatoriuje medication-subgroup (http://esveikata.lt/classifiers/Medication/MedicationSubgroup).\r\n\r\nNurodomas specialus vaistą apibūdinantis požymis naudojamas eRecepto posistemės. Galimos reikšmės nurodytos klasifikatoriuje prescription-mark (http://esveikata.lt/classifiers/PrescriptionMark).\r\n\r\nKlasifikavimo sistemos - pavadinimas, kodas. Galimos reikšmės nurodytos klasifikatoriuje http://esveikata.lt/classifiers/Medication/AtcCode.",
        "mustSupport": true
      },
      {
        "id": "MedicationKnowledge.medicineClassification.classification.coding",
        "path": "MedicationKnowledge.medicineClassification.classification.coding",
        "mustSupport": true
      },
      {
        "id": "MedicationKnowledge.medicineClassification.classification.coding.system",
        "path": "MedicationKnowledge.medicineClassification.classification.coding.system",
        "min": 1
      },
      {
        "id": "MedicationKnowledge.medicineClassification.classification.coding.code",
        "path": "MedicationKnowledge.medicineClassification.classification.coding.code",
        "min": 1
      },
      {
        "id": "MedicationKnowledge.medicineClassification.classification.coding.display",
        "path": "MedicationKnowledge.medicineClassification.classification.coding.display",
        "mustSupport": true
      },
