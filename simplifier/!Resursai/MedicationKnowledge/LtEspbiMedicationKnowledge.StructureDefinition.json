      {
        "id": "MedicationKnowledge.code",
        "path": "MedicationKnowledge.code",
        "short": "Vaisto identifikatorius suteiktas VAPRIS, NPAKID-7 arba NPAKID / Code that identifies this medication",
        "definition": "Naudojami klasifikatoriai:\r\nVAPRIS - http://esveikata.lt/classifiers/Identifier/VaprisID\r\n\r\nVaistinio preparato nacionalinis pakuotės identifikatorius (NPAKID) - http://esveikata.lt/classifiers/Identifier/NPAKID\r\n\r\nVaistinio preparato nacionalinis pakuotės identifikatorius (NPAKID-7) - http://esveikata.lt/classifiers/Identifier/NPAKID-7",
        "mustSupport": true
      },
