      {
        "id": "MedicationKnowledge.definitional.ingredient.type",
        "path": "MedicationKnowledge.definitional.ingredient.type",
        "short": "Kodas, apibrėžiantis medžiagų vaidmenį vaisto sudėtyje / A code that defines the type of ingredient, active, base, etc",
        "definition": "FHIR R5 rekomenduoja naudoti reikšmių sąrašą http://terminology.hl7.org/ValueSet/v3-RoleClassIngredientEntity, kuriame pateikiama 15 reikšmių, tokių kaip ACTI - veiklioji medžiaga,  ACTIB - veiklioji bazinė medžiaga, ADJV - pagalbinė / sustiprinanti medžiaga ir t. t.",
        "mustSupport": true
      },
      {
        "id": "MedicationKnowledge.definitional.ingredient.strength[x]",
        "path": "MedicationKnowledge.definitional.ingredient.strength[x]",
        "short": "Medžiagos kiekis vaisto vienete / Quantity of ingredient present",
        "definition": "Ratio - Struktūrizuotas komponento kiekis, kuriame aprašomas medžiagų stiprumas.\r\n\r\nQuantity - Veikliųjų medžiagų stiprumų, atskirtu „/“ simboliu, sąrašas. Jei VP sudaro keli komponentai, tai jų stiprumai atskiriami \"+\" simboliu.",
        "type": [
