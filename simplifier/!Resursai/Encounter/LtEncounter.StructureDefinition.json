      {
        "id": "Encounter.reason.use.coding.display",
        "path": "Encounter.reason.use.coding.display",
        "mustSupport": true
      },
      {
        "id": "Encounter.diagnosis",
        "path": "Encounter.diagnosis",
        "short": "Informacija apie GMP nurodytą(-as) diagnozę(-es) / EMS brigade diagnosis",
        "definition": "Informacija apie GMP nurodytą diagnozę (diagnozės TLK-10-AM kodas ir pavadinimas).",
