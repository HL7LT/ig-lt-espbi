        "id": "Encounter.actualPeriod",
        "path": "Encounter.actualPeriod",
        "short": "Atvykimo/Hospitalizavimo data ir laikas / Date and Time of Service of Hospitalization/arrival/visit",
        "definition": "Atvykimo / Hospitalizavimo periodas.",
