      {
        "id": "Patient.address",
        "path": "Patient.address",
        "short": "Paciento deklaruotos/gyvenamosios vietos adresas / Declared/residential address of patient",
        "definition": "Paciento deklaruotos/gyvenamosios vietos adreso duomenys.",
