{
  "resourceType": "StructureDefinition",
  "url": "http://esveikata.lt/fhir/StructureDefinition/lt-espbi-patient",
  "name": "LtEspbiPatient",
  "status": "draft",
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
  "type": "Patient",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Patient",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Patient.id",
        "path": "Patient.id",
        "short": "Resurso identifikatorius / Logical id of the resource",
        "definition": "Resurso unikalus identifikatorius, naudojamas resurso URL adresuose. Kartą priskirta, ši reikšmė niekada nesikeičia.",
        "mustSupport": true
      },
      {
        "id": "Patient.identifier",
        "path": "Patient.identifier",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "system"
            }
          ],
          "rules": "open"
        },
        "definition": "Paciento identifikatorius skirtas identifikuoti pacientą pagal tam tikra unikalų kodą.\r\n\r\nPaciento identifikatoriais gali būti Lietuvos Piliečio Asmens kodas, unikalus paciento ESI numeris arba asmens draudžiamojo asmens identifikacinis kodas iš draudžiamųjų privalomuoju sveikatos draudimo registro.",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "Patient.identifier:ESI",
        "path": "Patient.identifier",
        "sliceName": "ESI",
        "short": "ESI id / Patient EHI No",
        "definition": "Unikalus paciento ESI numeris.",
        "min": 1,
        "max": "1",
        "example": [
          {
            "label": "ESI",
            "valueIdentifier": {
              "system": "http://esveikata.lt/Identifier/Patient/ESI",
              "value": "232233"
            }
          }
        ]
      },
      {
        "id": "Patient.identifier:ESI.system",
        "path": "Patient.identifier.system",
        "min": 1,
        "patternUri": "http://esveikata.lt/Identifier/Patient/ESI"
      },
      {
        "id": "Patient.identifier:ESI.value",
        "path": "Patient.identifier.value",
        "min": 1
      },
      {
        "id": "Patient.identifier:others",
        "path": "Patient.identifier",
        "sliceName": "others",
        "short": "Kiti identifikatoriai / Other identifiers",
        "definition": "Paciento identifikatoriai skirti identifikuoti pacientą pagal tam tikrą unikalų kodą.\r\nIdentifikuojančios sistemos pavadinimas (system):\r\n- http://esveikata.lt/Identifier/PersonalCode. Lietuvos piliečio asmens kodas. Pastaba: jei asmuo turi asmens kodą.\r\n- http://esveikata.lt/Identifier/Patient/ESPBI. ESPBI id.\r\n- http://esveikata.lt/Identifier/Patient/DIK. Asmens draudžiamojo identifikacinis kodas iš draudžiamųjų privalomuoju sveikatos draudimo registro (DIK).\r\n- http://esveikata.lt/Identifier/Patient/SveidraID. Asmens identifikatorius SVEIDRA IS.\r\n- http://esveikata.lt/Identifier/Patient/eFormNumber. Užsienio valstybės piliečio Europos sveikatos draudimo kortelės arba laikinai ją pakeičiančio ES šalies narės piliečio sertifikato ar E formos pažymos nr.\r\n- http://esveikata.lt/Identifier/Patient/ForeignPersonalCode. Užsienio valstybės piliečio asmens kodas arba kitas identifikavimo numeris.\r\n- http://esveikata.lt/Identifier/eDelivery. Asmens E. pristatymo dėžutės duomenys.\r\n- http://esveikata.lt/classifiers/IdentityDocument/SerieNumber. Užsienio valstybės piliečio asmens tapatybę patvirtinančio dokumento serija ir numeris.\r\n",
        "example": [
          {
            "label": "Personal code",
            "valueIdentifier": {
              "system": "http://esveikata.lt/Identifier/PersonalCode",
              "value": "37512092729"
            }
          },
          {
            "label": "ESPBI",
            "valueIdentifier": {
              "system": "http://esveikata.lt/Identifier/Patient/ESPBI",
              "value": "454455"
            }
          },
          {
            "label": "DIK",
            "valueIdentifier": {
              "system": "http://esveikata.lt/Identifier/Patient/DIK",
              "value": "232233"
            }
          },
          {
            "label": "Sveidra ID",
            "valueIdentifier": {
              "system": "http://esveikata.lt/Identifier/Patient/SveidraID",
              "value": "1073765"
            }
          },
          {
            "label": "E form number",
            "valueIdentifier": {
              "system": "http://esveikata.lt/Identifier/Patient/eFormNumber",
              "value": "ABC123456"
            }
          },
          {
            "label": "Foreign personal code",
            "valueIdentifier": {
              "system": "http://esveikata.lt/Identifier/Patient/ForeignPersonalCode",
              "value": "987654321"
            }
          },
          {
            "label": "e-delivery",
            "valueIdentifier": {
              "system": "http://esveikata.lt/Identifier/eDelivery",
              "value": "vardpav123456"
            }
          },
          {
            "label": "Serie number",
            "valueIdentifier": {
              "system": "http://esveikata.lt/classifiers/IdentityDocument/SerieNumber",
              "value": "ABC123456"
            }
          }
        ],
        "constraint": [
          {
            "key": "pat-idn-1",
            "severity": "error",
            "human": "When identifier.system is IdentityDocument/SerieNumber, both ltExtDocumentRegisteredBy and ltExtDocumentRegisteredDate extensions are required.",
            "expression": "(system = 'http://esveikata.lt/classifiers/IdentityDocument/SerieNumber') implies (extension.where(url = 'http://esveikata.lt/Profile/ltnhr-patient/documentRegisteredBy').exists() and extension.where(url = 'http://esveikata.lt/Profile/ltnhr-patient/documentRegisteredDate').exists())"
          }
        ],
        "mustSupport": true
      },
      {
        "id": "Patient.identifier:others.extension:ltExtDocumentCountry",
        "path": "Patient.identifier.extension",
        "sliceName": "ltExtDocumentCountry",
        "short": "Užsienio valstybės piliečio asmens tapatybę patvirtinantį dokumentą išdavusios šalies triraidis kodas / Three-letter code of the country that issued the identity document of a foreign citizen",
        "definition": "Užsienio valstybės piliečio asmens tapatybę patvirtinantį dokumentą išdavusios šalies triraidis kodas.",
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "http://esveikata.lt/Profile/ltnhr-patient/documentCountry"
            ]
          }
        ],
        "mustSupport": true,
        "isModifier": false
      },
      {
        "id": "Patient.identifier:others.extension:ltExtDocumentRegisteredBy",
        "path": "Patient.identifier.extension",
        "sliceName": "ltExtDocumentRegisteredBy",
        "short": "Užsienio valstybės piliečio dokumentą užregistravęs specialistas /The practitioner registered insurance document of a foreign citizen",
        "definition": "Užsienio valstybės piliečio dokumentą užregistravęs specialistas.\r\n\r\nValidacinė taisyklė:\r\n- Privaloma pateikti, kai system = \"http://esveikata.lt/classifiers/IdentityDocument/SerieNumber\".",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "http://esveikata.lt/Profile/ltnhr-patient/documentRegisteredBy"
            ]
          }
        ],
        "mustSupport": true,
        "isModifier": false
      },
      {
        "id": "Patient.identifier:others.extension:ltExtDocumentRegisteredDate",
        "path": "Patient.identifier.extension",
        "sliceName": "ltExtDocumentRegisteredDate",
        "short": "Data, kada užregistruotas užsienio valstybės piliečio dokumentas / Date when the foreign citizen's document was registered",
        "definition": "Data, kada užregistruotas užsienio valstybės piliečio dokumentas.\r\n\r\nValidacinė taisyklė:\r\n- Privaloma pateikti, kai system = \"http://esveikata.lt/classifiers/IdentityDocument/SerieNumber\".",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "http://esveikata.lt/Profile/ltnhr-patient/documentRegisteredDate"
            ]
          }
        ],
        "mustSupport": true,
        "isModifier": false
      },
      {
        "id": "Patient.identifier:others.type",
        "path": "Patient.identifier.type",
        "short": "Užsienio valstybės piliečio asmens tapatybę patvirtinančio dokumento rūšis / Type of identity document of a foreign citizen",
        "definition": "Užsienio valstybės piliečio asmens tapatybę patvirtinančio dokumento rūšis, pavyzdžiui, Vairuotojo pažymėjimas, Socialinio draudimo pažymėjimas.",
        "mustSupport": true
      },
      {
        "id": "Patient.identifier:others.type.coding",
        "path": "Patient.identifier.type.coding",
        "min": 1,
        "max": "1"
      },
      {
        "id": "Patient.identifier:others.type.coding.system",
        "path": "Patient.identifier.type.coding.system",
        "min": 1,
        "patternUri": "http://esveikata.lt/classifiers/IdentityDocument/Type"
      },
      {
        "id": "Patient.identifier:others.type.coding.code",
        "path": "Patient.identifier.type.coding.code",
        "min": 1
      },
      {
        "id": "Patient.identifier:others.system",
        "path": "Patient.identifier.system",
        "min": 1,
        "binding": {
          "strength": "extensible",
          "valueSet": "http://esveikata.lt/fhir/ValueSet/lt-espbi-patient-identifier"
        }
      },
      {
        "id": "Patient.identifier:others.value",
        "path": "Patient.identifier.value",
        "min": 1
      },
      {
        "id": "Patient.name",
        "path": "Patient.name",
        "short": "Paciento vardo/pavardės duomenys / Patient name data",
        "definition": "Paciento vardas ir pavardė.",
        "mustSupport": true
      },
      {
        "id": "Patient.name.family",
        "path": "Patient.name.family",
        "short": "Paciento pavardė / Patient surname",
        "definition": "Paciento pavardė.",
        "mustSupport": true
      },
      {
        "id": "Patient.name.given",
