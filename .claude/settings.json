{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(sushi *)",
      "Bash(java -jar publisher.jar *)",
      "Bash(java -jar ../publisher.jar *)",
      "Bash(java -jar input-cache/publisher.jar *)",
      "Bash(java -jar ./input-cache/publisher.jar *)",
      "Bash(./_genonce.sh*)",
      "Bash(./_gencontinuous.sh*)",
      "Bash(./_updatePublisher.sh*)",
      "Bash(./_build.sh*)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "1200000",
    "BASH_MAX_TIMEOUT_MS": "1200000"
  }
}
